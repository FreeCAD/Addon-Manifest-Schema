<?xml
    version = '1.0'
    encoding = 'UTF-8'
?>

<xs:schema xmlns:xs = 'http://www.w3.org/2001/XMLSchema' >

    <xs:include schemaLocation = 'SPDX-Licenses.xsd' />

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <xs:element name = 'license' >

        <xs:annotation>
            <xs:documentation>

                <![CDATA[

                    <h3>

                        <a href = 'https://wiki.freecad.org/Package_Metadata#.3Clicense.3E' >
                            🛈 ⁣
                        </a>

                        License

                    </h3>

                    <hr>

                    <p> License(s) the content of your addon is published under. </p>

                ]]>

            </xs:documentation>
        </xs:annotation>

        <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base = 'Version' >

                    <xs:attribute
                        name = 'file'
                        type = 'xs:string'
                        use = 'optional'
                    />

                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>

    </xs:element>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <xs:simpleType name = 'Version' >
        <xs:union>

            <!-- Custom License -->

            <xs:simpleType>
                <xs:restriction base = 'xs:string' >
                    <xs:pattern value = '[\s\S]+' />
                </xs:restriction>
            </xs:simpleType>

            <!-- All Rights Reserved -->

            <xs:simpleType>
                <xs:restriction base = 'xs:string' >
                    <xs:enumeration value = 'UNLICENSED' />
                </xs:restriction>
            </xs:simpleType>

            <!-- SPDX Licenses -->

                <xs:simpleType>
                <xs:restriction base = 'SPDX-License' />
            </xs:simpleType>

        </xs:union>

    </xs:simpleType>

</xs:schema>
