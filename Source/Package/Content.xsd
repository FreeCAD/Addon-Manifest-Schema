<?xml
    version = '1.1'
    encoding = 'UTF-8'
?>

<xs:schema xmlns:xs = 'http://www.w3.org/2001/XMLSchema' >

    <xs:include schemaLocation = './Description.xsd' />
    <xs:include schemaLocation = './Name.xsd' />
    <xs:include schemaLocation = './Url.xsd' />
    <xs:include schemaLocation = './Tag.xsd' />

    <xs:include schemaLocation = 'Content/SubDirectory.xsd' />
    <xs:include schemaLocation = 'Content/ClassName.xsd' />
    <xs:include schemaLocation = 'Content/Workbench.xsd' />
    <xs:include schemaLocation = 'Content/Icon.xsd' />
    <xs:include schemaLocation = 'Content/File.xsd' />

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <xs:element name = 'content' >

        <xs:annotation>
            <xs:documentation>

                [🛈](https://wiki.freecad.org/Package_Metadata#.3Ccontent.3E)

                Content

            </xs:documentation>
        </xs:annotation>

        <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

        <xs:complexType>
            <xs:choice>

                <xs:element
                    name = 'preferencepack'
                    type = 'Content'
                />

                <xs:element
                    ref = 'workbench'
                />

                 <xs:element
                    name = 'macro'
                    type = 'Content'
                />

            </xs:choice>
        </xs:complexType>

    </xs:element>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <xs:complexType name = 'Content' >
        <xs:sequence>
            <xs:choice maxOccurs = 'unbounded' >

                <xs:element ref = 'subdirectory' />
                <xs:element ref = 'description' />
                <xs:element ref = 'icon' />
                <xs:element ref = 'name' />


                <xs:element
                    maxOccurs = 'unbounded'
                    ref = 'file'
                />

                <xs:element
                    maxOccurs = 'unbounded'
                    ref = 'url'
                />

                <xs:element
                    maxOccurs = 'unbounded'
                    ref = 'tag'
                />

            </xs:choice>
        </xs:sequence>
    </xs:complexType>

</xs:schema>