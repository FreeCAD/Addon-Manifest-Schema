<?xml
    version = '1.0'
    encoding = 'UTF-8'
?>

<xs:schema
    elementFormDefault = 'qualified'
    xmlns:xs = 'http://www.w3.org/2001/XMLSchema'
>

    <xs:include schemaLocation = '../Preference/Name.xsd' />
    <xs:include schemaLocation = '../Preference/Type.xsd' />
    <xs:include schemaLocation = './mod.xsd' />

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <xs:element
        substitutionGroup = 'Content-Item'
        final = '#all'
        name = 'preferencepack'
    >

        <xs:annotation>
            <xs:documentation>

                <![CDATA[

                    <h3>

                        <a href = 'https://wiki.freecad.org/Package_Metadata#.3Ccontent.3E' >
                            🛈 ⁣
                        </a>

                        Preference Pack

                    </h3>

                    <hr>

                    <p> Declares a preference pack. </p>

                ]]>

            </xs:documentation>
        </xs:annotation>

        <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

        <xs:complexType>
            <xs:sequence>

                <xs:element
                    maxOccurs = '1'
                    minOccurs = '1'
                    type = 'Preference-Name'
                    name = 'name'
                />

                <xs:element
                    maxOccurs = '1'
                    minOccurs = '0'
                    type = 'Preference-Type'
                    name = 'type'
                />

            </xs:sequence>
        </xs:complexType>

    </xs:element>

</xs:schema>