<?xml
    version = '1.0'
    encoding = 'UTF-8'
?>

<xs:schema 
    elementFormDefault = 'qualified'
    xmlns:xs = 'http://www.w3.org/2001/XMLSchema' 
>

    <xs:include schemaLocation = '../Helper/Tag.xsd' />

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <xs:complexType
        final = '#all'
        name = 'Package-Tag'
    >

        <xs:annotation>
            <xs:documentation>

                <![CDATA[

                    <h3>

                        <a href = 'https://wiki.freecad.org/Package_Metadata#.3Ctag.3E' >
                            🛈 ⁣
                        </a>

                        Tag

                    </h3>

                    <hr>

                    <p> A keyword describing an aspect of this package. </p>

                    <p> ⁣ </p>

                    <h4> ⚠ ⁣ Reminder </h4>

                    <ul>
                        <li> Tags should be 3+ letters long. </li>
                        <li> Add at least 3 different tags. </li>
                    </ul>

                ]]>

            </xs:documentation>
        </xs:annotation>

        <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

        <xs:simpleContent>
            <xs:extension base = 'Tag' />
        </xs:simpleContent>

    </xs:complexType>

</xs:schema>