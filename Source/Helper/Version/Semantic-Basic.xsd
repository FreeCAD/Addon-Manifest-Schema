<?xml
    version = '1.0'
    encoding = 'UTF-8'
?>

<xs:schema 
    elementFormDefault = 'qualified'
    xmlns:xs = 'http://www.w3.org/2001/XMLSchema' 
>

    <xs:simpleType name = 'Version-Semantic-Basic' >
        <xs:union>

            <!-- General -->

            <xs:simpleType>
                <xs:restriction base = 'xs:string'>
                    <xs:pattern value = '(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)' />
                </xs:restriction>
            </xs:simpleType>

            <!-- Examples -->

            <xs:simpleType>
                <xs:restriction base = 'xs:string' >
                    <xs:enumeration value = '0.1.0' />
                    <xs:enumeration value = '5.10.1' />
                    <xs:enumeration value = '1.4.152' />
                </xs:restriction>
            </xs:simpleType>

        </xs:union>
    </xs:simpleType>

</xs:schema>