<?xml
    version = '1.0'
    encoding = 'UTF-8'
?>

<xs:schema xmlns:xs = 'http://www.w3.org/2001/XMLSchema' >

    <xs:simpleType name = 'Version-Calender' >

        <xs:restriction base = 'xs:token'>
            <xs:pattern value = '([1-9]{4})\.([0-9][1-9])\.([0-9][1-9])(-((0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(\.(0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\+([0-9a-zA-Z-]+(\.[0-9a-zA-Z-]+)*))?' />
        </xs:restriction>

    </xs:simpleType>

</xs:schema>