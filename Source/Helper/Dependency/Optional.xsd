<?xml
    version = '1.0'
    encoding = 'UTF-8'
?>

<xs:schema xmlns:xs = 'http://www.w3.org/2001/XMLSchema' >

    <xs:attribute
        type = 'xs:boolean'
        name = 'optional'
    >

        <xs:annotation>
            <xs:documentation>

                <![CDATA[

                    <h3>

                        <a href = 'https://wiki.freecad.org/Package_Metadata#Attributes_6' >
                            🛈 ⁣
                        </a>

                        Optional

                    </h3>

                    <hr>

                    <p> If `true` the dependency will be shown as an option while installing. </p>

                    <p> ⁣ </p>

                    <h4> ⚠ ⁣ Reminder </h4>

                    Addons must work without optional dependencies being installed.

                ]]>

            </xs:documentation>
        </xs:annotation>

    </xs:attribute>

</xs:schema>