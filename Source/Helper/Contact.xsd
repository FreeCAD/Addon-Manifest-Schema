<?xml
    version = '1.0'
    encoding = 'UTF-8'
?>

<xs:schema xmlns:xs = 'http://www.w3.org/2001/XMLSchema' >

    <xs:include schemaLocation = './Types.xsd' />
    <xs:include schemaLocation = './Email.xsd' />

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <xs:complexType name = 'Contact' >
        <xs:simpleContent>
            <xs:extension base = 'xs:string' >

                <xs:attribute
                    name = 'email'
                    type = 'Email'
                    use = 'optional'
                />

            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

</xs:schema>